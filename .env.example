# Copia este archivo como .env y llena tus llaves

# Guiones (Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Solo si tu llave no está ligada a un workspace
# ANTHROPIC_WORKSPACE_ID=

# Voz IA: "openai" o "elevenlabs"
TTS_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Opcional: otra voz solo para el canal de programación
# ELEVENLABS_VOICE_ID_CODIGO=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Opcional: ruta a Chrome si Remotion no descarga su navegador
# CHROME_PATH=/usr/bin/google-chrome
